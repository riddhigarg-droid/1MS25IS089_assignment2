# NEXUS — ReAct Intelligence Environment Configuration

# Google Gemini API Key (Required for AI generation)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (gemini-3.5-flash-lite recommended)
DEFAULT_MODEL=gemini-3.5-flash-lite

# Maximum ReAct agent iterations (1 to 10)
MAX_ITERATIONS=5

# Primary Search Provider: duckduckgo (default, no key needed), tavily, serper
SEARCH_PROVIDER=duckduckgo

# Optional: Tavily Search API Key (https://tavily.com)
TAVILY_API_KEY=

# Optional: Serper Google Search API Key (https://serper.dev)
SERPER_API_KEY=

# Search Configuration
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=12.0
